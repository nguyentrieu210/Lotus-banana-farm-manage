    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "HR User",
      "read": 1,
      "report": 1
    },
    {
      "role": "Lotus Integration User",
      "read": 1
    }

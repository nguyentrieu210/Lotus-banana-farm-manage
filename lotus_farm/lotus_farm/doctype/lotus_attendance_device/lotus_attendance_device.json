    },
    {
      "fieldname": "farm",
      "label": "Vườn",
      "fieldtype": "Link",
      "options": "Farm",
      "reqd": 1
    },
    {
      "fieldname": "device_code",
      "label": "Mã máy",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "device_name",
      "label": "Tên máy",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "model",
      "label": "Model máy",
      "fieldtype": "Data"
    },
    {
      "fieldname": "serial_number",
      "label": "Số serial",
      "fieldtype": "Data"
    },
    {
      "fieldname": "connection_mode",
      "label": "Cách kết nối",
      "fieldtype": "Select",
      "options": "File CSV\nADMS\nLAN SDK\nVendor Cloud",
      "reqd": 1
    },
    {
      "fieldname": "timezone",

{
  "doctype": "DocType",
  "name": "Work Type",
  "module": "Lotus Farm",
  "track_changes": 1,
  "field_order": [
    "work_code",
    "work_name",
    "category",
    "uom",
    "payment_basis",
    "allow_piecework",
    "allow_daywork",
    "piecework_rate",
    "productivity_per_workday",
    "active"
  ],
  "fields": [
    {
      "fieldname": "work_code",
      "label": "Work Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "work_name",
      "label": "Work Name",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Link",
      "options": "Work Category",
      "reqd": 1
    },
    {
      "fieldname": "uom",
      "label": "Uom",
      "fieldtype": "Link",
      "options": "UOM",
      "reqd": 1
    },
    {
      "fieldname": "payment_basis",
      "fieldtype": "Select",
      "label": "Payment Basis",
      "options": "\nPiece\nDaywork\nBoth",
      "read_only": 1,
      "hidden": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "allow_piecework",
      "label": "Allow Piecework",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "allow_daywork",
      "label": "Allow Daywork",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "piecework_rate",
      "label": "Đơn giá công khoán / 1 ĐVT",
      "fieldtype": "Currency",
      "default": "0",
      "description": "Giá niêm yết cho một đơn vị sản lượng đạt nghiệm thu. Không phải tiền công nhật."
    },
    {
      "fieldname": "productivity_per_workday",
      "label": "Năng suất trung bình (ĐVT / công)",
      "fieldtype": "Float",
      "precision": "6",
      "description": "Một công lao động dự kiến làm được bao nhiêu đơn vị công việc. Không phải đơn giá."
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1"
    }
  ],
  "autoname": "hash",
  "permissions": [
    {
      "role": "Lotus Farm Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "create": 1,
      "write": 1,
      "delete": 1
    },
    {
      "role": "Lotus Auditor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ],
  "title_field": "work_name",
  "show_title_field_in_link": 1,
  "search_fields": "work_code"
}

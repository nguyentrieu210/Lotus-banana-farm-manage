{
  "name": "Lotus Forecast Snapshot",
  "doctype": "DocType",
  "module": "Lotus Farm",
  "autoname": "hash",
  "track_changes": 1,
  "title_field": "week_label",
  "sort_field": "snapshot_date",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "farm",
      "fieldtype": "Link",
      "label": "Vườn",
      "options": "Farm",
      "ignore_user_permissions": 1,
      "reqd": 1
    },
    {
      "fieldname": "snapshot_date",
      "fieldtype": "Date",
      "label": "Ngày chốt",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "week_label",
      "fieldtype": "Data",
      "label": "Tuần",
      "in_list_view": 1
    },
    {
      "fieldname": "kind",
      "fieldtype": "Select",
      "label": "Loại",
      "options": "Weekly\nManual",
      "default": "Weekly",
      "reqd": 1
    },
    {
      "fieldname": "week_start",
      "fieldtype": "Date",
      "label": "Thứ Hai đầu tuần",
      "description": "Bản chốt tuần: dự thu như hệ thống thấy lúc 0 giờ ngày này."
    },
    {
      "fieldname": "as_of",
      "fieldtype": "Datetime",
      "label": "Tính theo số đến lúc",
      "description": "Chỉ dòng sổ lô đã xác nhận trước lúc này và chưa bị hủy trước lúc này."
    },
    {
      "fieldname": "weekly_key",
      "fieldtype": "Data",
      "label": "Khóa tuần",
      "unique": 1,
      "read_only": 1,
      "hidden": 1,
      "description": "Vườn:thứ Hai, chỉ bản chốt tuần; giữ mỗi tuần một bản."
    },
    {
      "fieldname": "limits",
      "fieldtype": "Small Text",
      "label": "Giới hạn khi dựng lại",
      "read_only": 1
    },
    {
      "fieldname": "profile_refs",
      "fieldtype": "Small Text",
      "label": "Bộ tham số đã dùng"
    },
    {
      "fieldname": "total_bunches",
      "fieldtype": "Int",
      "label": "Tổng buồng",
      "in_list_view": 1
    },
    {
      "fieldname": "total_kg",
      "fieldtype": "Float",
      "label": "Tổng kg",
      "in_list_view": 1
    },
    {
      "fieldname": "rows_json",
      "fieldtype": "Long Text",
      "label": "Chi tiết"
    }
  ],
  "permissions": [
    {
      "role": "Lotus Farm Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Field Supervisor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Team Leader",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Field Inspector",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ],
  "field_order": [
    "farm",
    "snapshot_date",
    "week_label",
    "kind",
    "week_start",
    "as_of",
    "weekly_key",
    "limits",
    "profile_refs",
    "total_bunches",
    "total_kg",
    "rows_json"
  ]
}

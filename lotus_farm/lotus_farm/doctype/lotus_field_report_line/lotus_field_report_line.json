{
  "doctype": "DocType",
  "name": "Lotus Field Report Line",
  "module": "Lotus Farm",
  "autoname": "hash",
  "istable": 1,
  "field_order": [
    "line_id",
    "section",
    "assignment",
    "work_type",
    "pay_kind",
    "work_team",
    "location",
    "farm_block",
    "blocks",
    "zone",
    "workdays_am",
    "workdays_pm",
    "workdays",
    "qty",
    "done",
    "uom",
    "whole_lot",
    "lot_area_ha",
    "lot_trees",
    "piece_rate",
    "rate",
    "amount",
    "paid_qty",
    "under_norm",
    "under_norm_reason",
    "bunch_tag",
    "over_cut",
    "comment",
    "proposal",
    "note",
    "entered_by"
  ],
  "fields": [
    {
      "fieldname": "line_id",
      "fieldtype": "Data",
      "label": "Mã dòng",
      "reqd": 1
    },
    {
      "fieldname": "section",
      "fieldtype": "Select",
      "label": "Mục",
      "options": "Field\nBunch",
      "default": "Field"
    },
    {
      "fieldname": "work_type",
      "fieldtype": "Link",
      "label": "Công việc",
      "ignore_user_permissions": 1,
      "options": "Work Type",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "pay_kind",
      "fieldtype": "Select",
      "label": "Loại công",
      "options": "Daywork\nPiece",
      "default": "Daywork",
      "in_list_view": 1
    },
    {
      "fieldname": "work_team",
      "fieldtype": "Link",
      "label": "Tổ",
      "ignore_user_permissions": 1,
      "options": "Work Team"
    },
    {
      "fieldname": "location",
      "fieldtype": "Select",
      "label": "Vị trí",
      "options": "Block\nBlocks\nZone",
      "default": "Block"
    },
    {
      "fieldname": "farm_block",
      "fieldtype": "Link",
      "label": "Lô",
      "ignore_user_permissions": 1,
      "options": "Farm Block",
      "in_list_view": 1
    },
    {
      "fieldname": "blocks",
      "fieldtype": "Small Text",
      "label": "Các lô"
    },
    {
      "fieldname": "zone",
      "fieldtype": "Data",
      "label": "Cả khu"
    },
    {
      "fieldname": "workdays_am",
      "fieldtype": "Float",
      "label": "Công sáng"
    },
    {
      "fieldname": "workdays_pm",
      "fieldtype": "Float",
      "label": "Công chiều"
    },
    {
      "fieldname": "workdays",
      "fieldtype": "Float",
      "label": "Tổng công",
      "read_only": 1
    },
    {
      "fieldname": "qty",
      "fieldtype": "Float",
      "label": "Khối lượng",
      "in_list_view": 1
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "Đơn vị",
      "ignore_user_permissions": 1,
      "options": "UOM"
    },
    {
      "fieldname": "whole_lot",
      "fieldtype": "Check",
      "label": "Cả lô"
    },
    {
      "fieldname": "lot_area_ha",
      "fieldtype": "Float",
      "label": "Diện tích lô (ha)",
      "read_only": 1
    },
    {
      "fieldname": "lot_trees",
      "fieldtype": "Int",
      "label": "Số cây lô",
      "read_only": 1
    },
    {
      "fieldname": "piece_rate",
      "fieldtype": "Link",
      "label": "Giá khoán áp dụng",
      "ignore_user_permissions": 1,
      "options": "Lotus Piece Rate",
      "read_only": 1
    },
    {
      "fieldname": "rate",
      "fieldtype": "Currency",
      "label": "Đơn giá",
      "read_only": 1
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Thành tiền",
      "read_only": 1
    },
    {
      "fieldname": "under_norm",
      "fieldtype": "Check",
      "label": "Chưa đạt ngày công",
      "read_only": 1
    },
    {
      "fieldname": "under_norm_reason",
      "fieldtype": "Small Text",
      "label": "Lý do chưa đạt"
    },
    {
      "fieldname": "bunch_tag",
      "fieldtype": "Link",
      "label": "Màu dây",
      "ignore_user_permissions": 1,
      "options": "Bunch Tag",
      "read_only": 1
    },
    {
      "fieldname": "comment",
      "fieldtype": "Small Text",
      "label": "Nhận xét"
    },
    {
      "fieldname": "proposal",
      "fieldtype": "Small Text",
      "label": "Đề xuất giải pháp"
    },
    {
      "fieldname": "note",
      "fieldtype": "Small Text",
      "label": "Ghi chú"
    },
    {
      "fieldname": "entered_by",
      "fieldtype": "Link",
      "label": "Người nhập",
      "ignore_user_permissions": 1,
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "assignment",
      "fieldtype": "Link",
      "label": "Phiếu giao",
      "options": "Lotus Work Assignment",
      "ignore_user_permissions": 1
    },
    {
      "fieldname": "done",
      "fieldtype": "Check",
      "label": "Xong lô",
      "default": "0"
    },
    {
      "fieldname": "paid_qty",
      "fieldtype": "Float",
      "label": "Khối lượng tính tiền"
    },
    {
      "fieldname": "over_cut",
      "fieldtype": "Check",
      "label": "Vượt số cắt bắp",
      "default": "0"
    }
  ],
  "permissions": []
}

{
  "doctype": "DocType",
  "name": "Farm Block",
  "module": "Lotus Farm",
  "autoname": "hash",
  "title_field": "block_name",
  "track_changes": 1,
  "field_order": [
    "farm",
    "block_name",
    "block_code",
    "area_ha",
    "variety",
    "planting_date",
    "planting_density",
    "irrigation_zone",
    "manager",
    "active",
    "notes"
  ],
  "fields": [
    {
      "fieldname": "farm",
      "fieldtype": "Link",
      "label": "Farm",
      "options": "Farm",
      "reqd": 1
    },
    {
      "fieldname": "block_name",
      "fieldtype": "Data",
      "label": "Block Name",
      "reqd": 1
    },
    {
      "fieldname": "block_code",
      "fieldtype": "Data",
      "label": "Block Code",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "area_ha",
      "fieldtype": "Float",
      "label": "Area (ha)",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "variety",
      "fieldtype": "Link",
      "label": "Variety",
      "options": "Banana Variety"
    },
    {
      "fieldname": "planting_date",
      "fieldtype": "Date",
      "label": "Ngày trồng ban đầu",
      "description": "Dùng dự phóng khi chưa khai báo vụ; nếu trồng nhiều đợt phải tách đợt/vụ."
    },
    {
      "fieldname": "planting_density",
      "fieldtype": "Float",
      "label": "Planting Density (plants/ha)",
      "non_negative": 1
    },
    {
      "fieldname": "irrigation_zone",
      "fieldtype": "Data",
      "label": "Irrigation Zone"
    },
    {
      "fieldname": "manager",
      "fieldtype": "Link",
      "label": "Block Manager",
      "options": "User"
    },
    {
      "fieldname": "active",
      "fieldtype": "Check",
      "label": "Active",
      "default": "1"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Notes"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "create": 1,
      "read": 1,
      "write": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ]
}

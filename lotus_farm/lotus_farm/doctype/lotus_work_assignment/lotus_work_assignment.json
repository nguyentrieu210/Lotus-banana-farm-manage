{
  "doctype": "DocType",
  "name": "Lotus Work Assignment",
  "module": "Lotus Farm",
  "autoname": "hash",
  "track_changes": 1,
  "title_field": "farm_block",
  "sort_field": "assigned_on",
  "field_order": [
    "kind",
    "company",
    "farm",
    "crew",
    "work_team",
    "farm_block",
    "work_type",
    "assigned_on",
    "due_date",
    "state",
    "ended_on",
    "done_report",
    "done_line",
    "done_date",
    "cancel_reason",
    "assigned_by",
    "work_group",
    "pay_mode",
    "cap_basis",
    "piece_rate",
    "rate",
    "uom",
    "basis",
    "norm_min",
    "lot_area_ha",
    "lot_trees",
    "qty_total",
    "amount",
    "reported_by",
    "reported_at",
    "approved_by",
    "approved_at",
    "inspection",
    "locked_at",
    "return_reason"
  ],
  "fields": [
    {
      "fieldname": "kind",
      "fieldtype": "Select",
      "label": "Loại giao",
      "options": "Round\nBunch",
      "default": "Round",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "label": "Công ty",
      "options": "Company",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "farm",
      "fieldtype": "Link",
      "label": "Vườn",
      "options": "Farm",
      "ignore_user_permissions": 1,
      "reqd": 1
    },
    {
      "fieldname": "crew",
      "fieldtype": "Link",
      "label": "Đội",
      "options": "Work Team",
      "ignore_user_permissions": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "work_team",
      "fieldtype": "Link",
      "label": "Tổ",
      "options": "Work Team",
      "ignore_user_permissions": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "farm_block",
      "fieldtype": "Link",
      "label": "Lô",
      "options": "Farm Block",
      "ignore_user_permissions": 1,
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "work_type",
      "fieldtype": "Link",
      "label": "Công việc",
      "options": "Work Type",
      "ignore_user_permissions": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "assigned_on",
      "fieldtype": "Date",
      "label": "Ngày giao",
      "reqd": 1
    },
    {
      "fieldname": "due_date",
      "fieldtype": "Date",
      "label": "Hạn xong"
    },
    {
      "fieldname": "state",
      "fieldtype": "Select",
      "label": "Trạng thái",
      "options": "Open\nReported\nApproved\nPassed\nFailed\nLocked\nCancelled\nDone\nEnded",
      "default": "Open",
      "in_list_view": 1
    },
    {
      "fieldname": "ended_on",
      "fieldtype": "Date",
      "label": "Ngày kết thúc giao"
    },
    {
      "fieldname": "done_report",
      "fieldtype": "Link",
      "label": "Báo cáo xong",
      "options": "Lotus Field Report",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "done_line",
      "fieldtype": "Data",
      "label": "Dòng báo xong",
      "read_only": 1
    },
    {
      "fieldname": "done_date",
      "fieldtype": "Date",
      "label": "Ngày xong",
      "read_only": 1
    },
    {
      "fieldname": "cancel_reason",
      "fieldtype": "Small Text",
      "label": "Lý do huỷ / đổi"
    },
    {
      "fieldname": "assigned_by",
      "fieldtype": "Link",
      "label": "Người giao",
      "options": "User",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "work_group",
      "fieldtype": "Select",
      "label": "Nhóm việc",
      "options": "\nBunch\nField\nProtection",
      "read_only": 1
    },
    {
      "fieldname": "pay_mode",
      "fieldtype": "Select",
      "label": "Cách trả",
      "options": "\nCount\nLot\nDaywork",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "cap_basis",
      "fieldtype": "Select",
      "label": "Trần theo",
      "options": "\nCutBud\nLotTrees\nLotArea\nNone",
      "read_only": 1
    },
    {
      "fieldname": "piece_rate",
      "fieldtype": "Link",
      "label": "Giá khoán áp dụng",
      "options": "Lotus Piece Rate",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "rate",
      "fieldtype": "Currency",
      "label": "Đơn giá",
      "read_only": 1
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "label": "Đơn vị",
      "options": "UOM",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "basis",
      "fieldtype": "Data",
      "label": "Tính theo",
      "read_only": 1
    },
    {
      "fieldname": "norm_min",
      "fieldtype": "Float",
      "label": "Năng suất tối thiểu / công",
      "read_only": 1
    },
    {
      "fieldname": "lot_area_ha",
      "fieldtype": "Float",
      "label": "Diện tích lô (ha)",
      "read_only": 1
    },
    {
      "fieldname": "lot_trees",
      "fieldtype": "Int",
      "label": "Số cây lô",
      "read_only": 1
    },
    {
      "fieldname": "qty_total",
      "fieldtype": "Float",
      "label": "Khối lượng đã báo",
      "read_only": 1
    },
    {
      "fieldname": "amount",
      "fieldtype": "Currency",
      "label": "Thành tiền khoán",
      "read_only": 1
    },
    {
      "fieldname": "reported_by",
      "fieldtype": "Link",
      "label": "Người báo xong",
      "options": "User",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "reported_at",
      "fieldtype": "Datetime",
      "label": "Lúc báo xong",
      "read_only": 1
    },
    {
      "fieldname": "approved_by",
      "fieldtype": "Link",
      "label": "Đội trưởng duyệt",
      "options": "User",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "approved_at",
      "fieldtype": "Datetime",
      "label": "Lúc duyệt",
      "read_only": 1
    },
    {
      "fieldname": "inspection",
      "fieldtype": "Link",
      "label": "Phiếu nghiệm thu",
      "options": "Lotus Work Inspection",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "locked_at",
      "fieldtype": "Datetime",
      "label": "Lúc khoá tính tiền",
      "read_only": 1
    },
    {
      "fieldname": "return_reason",
      "fieldtype": "Small Text",
      "label": "Lý do trả lại"
    }
  ],
  "permissions": [
    {
      "role": "Lotus Farm Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Field Supervisor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Team Leader",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Field Inspector",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ]
}

      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "requester",
      "fieldtype": "Link",
      "label": "Người đề xuất",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "lines",
      "fieldtype": "Table",
      "label": "Các khoản đề xuất",

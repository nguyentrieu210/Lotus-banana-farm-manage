      "report": 1
    },
    {
      "role": "Lotus Field Supervisor",
      "read": 1,
      "report": 1
    },
    {
      "role": "Lotus Farm Manager",
      "read": 1,
      "report": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1
    }

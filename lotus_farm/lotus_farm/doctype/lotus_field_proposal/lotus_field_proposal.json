    {
      "fieldname": "total_estimate",
      "fieldtype": "Currency",
      "label": "Tổng tiền dự kiến",
      "read_only": 1
    },
    {
      "fieldname": "reviewer",
      "fieldtype": "Link",
      "label": "Người xử lý",

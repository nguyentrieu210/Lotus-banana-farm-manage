    },
    {
      "fieldname": "farm",
      "fieldtype": "Link",
      "label": "Vườn",
      "options": "Farm",
      "reqd": 1
    },
    {
      "fieldname": "farm_block",
      "fieldtype": "Link",
      "label": "Lô / khu vực",
      "options": "Farm Block"
    },
    {
      "fieldname": "kind",
      "fieldtype": "Select",
      "label": "Loại đề xuất",
      "options": "Vật tư\nChi phí",
      "reqd": 1
    },
    {
      "fieldname": "needed_date",
      "fieldtype": "Date",
      "label": "Ngày cần",
      "reqd": 1
    },
    {
      "fieldname": "reason",
      "fieldtype": "Small Text",
      "label": "Lý do đề xuất",
      "reqd": 1
    },
    {
      "fieldname": "state",
      "fieldtype": "Select",
      "label": "Trạng thái",

{
  "doctype": "DocType",
  "name": "Lotus Field Proposal",
  "module": "Lotus Farm",
  "autoname": "format:LFP-{YYYY}-{#####}",
  "track_changes": 1,
  "field_order": [
    "company",
    "farm",
    "farm_block",
    "kind",
    "needed_date",
    "reason",
    "state",
    "requester",
    "lines",
    "total_estimate",
    "reviewer",
    "review_note",
    "reviewed_at"

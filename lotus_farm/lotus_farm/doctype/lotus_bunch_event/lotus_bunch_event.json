{
  "name": "Lotus Bunch Event",
  "doctype": "DocType",
  "module": "Lotus Farm",
  "autoname": "hash",
  "track_changes": 1,
  "title_field": "farm_block",
  "sort_field": "event_date",
  "sort_order": "DESC",
  "fields": [
    {
      "fieldname": "farm",
      "fieldtype": "Link",
      "label": "Vườn",
      "options": "Farm",
      "ignore_user_permissions": 1,
      "reqd": 1
    },
    {
      "fieldname": "farm_block",
      "fieldtype": "Link",
      "label": "Lô",
      "options": "Farm Block",
      "ignore_user_permissions": 1,
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "work_team",
      "fieldtype": "Link",
      "label": "Tổ",
      "options": "Work Team",
      "ignore_user_permissions": 1
    },
    {
      "fieldname": "cycle_no",
      "fieldtype": "Int",
      "label": "Vụ",
      "reqd": 1
    },
    {
      "fieldname": "event_type",
      "fieldtype": "Select",
      "label": "Việc",
      "options": "Sucker Select\nBud Injection\nCut Bud\nReject\nHarvest",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "event_date",
      "fieldtype": "Date",
      "label": "Ngày làm việc",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "qty",
      "fieldtype": "Int",
      "label": "Số buồng / số chồi ước tính",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "area_ha",
      "fieldtype": "Float",
      "label": "Diện tích đã làm (ha)"
    },
    {
      "fieldname": "bunch_tag",
      "fieldtype": "Link",
      "label": "Màu dây",
      "options": "Bunch Tag",
      "ignore_user_permissions": 1
    },
    {
      "fieldname": "reject_stage",
      "fieldtype": "Select",
      "label": "Giai đoạn loại",
      "options": "\nBefore Cut\nAfter Cut"
    },
    {
      "fieldname": "reason",
      "fieldtype": "Link",
      "label": "Lý do loại",
      "options": "Cancellation Reason",
      "ignore_user_permissions": 1
    },
    {
      "fieldname": "weight_kg",
      "fieldtype": "Float",
      "label": "Khối lượng thu (kg)"
    },
    {
      "fieldname": "source_type",
      "fieldtype": "Select",
      "label": "Nguồn",
      "options": "Work Entry\nOpening Import\nManual",
      "reqd": 1
    },
    {
      "fieldname": "source_name",
      "fieldtype": "Data",
      "label": "Chứng từ nguồn"
    },
    {
      "fieldname": "source_key",
      "fieldtype": "Data",
      "label": "Khóa nguồn",
      "reqd": 1,
      "unique": 1
    },
    {
      "fieldname": "state",
      "fieldtype": "Select",
      "label": "Trạng thái",
      "options": "Draft\nConfirmed\nVoided",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "entered_by",
      "fieldtype": "Link",
      "label": "Người nhập",
      "options": "User",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "confirmed_by",
      "fieldtype": "Link",
      "label": "Người xác nhận",
      "options": "User",
      "ignore_user_permissions": 1,
      "read_only": 1
    },
    {
      "fieldname": "confirmed_at",
      "fieldtype": "Datetime",
      "label": "Lúc xác nhận",
      "read_only": 1
    },
    {
      "fieldname": "void_reason",
      "fieldtype": "Small Text",
      "label": "Lý do hủy dòng"
    },
    {
      "fieldname": "notes",
      "fieldtype": "Small Text",
      "label": "Ghi chú"
    }
  ],
  "permissions": [
    {
      "role": "Lotus Farm Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Field Supervisor",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Team Leader",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Lotus Field Inspector",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
  ],
  "field_order": [
    "farm",
    "farm_block",
    "work_team",
    "cycle_no",
    "event_type",
    "event_date",
    "qty",
    "area_ha",
    "bunch_tag",
    "reject_stage",
    "reason",
    "weight_kg",
    "source_type",
    "source_name",
    "source_key",
    "state",
    "entered_by",
    "confirmed_by",
    "confirmed_at",
    "void_reason",
    "notes"
  ]
}

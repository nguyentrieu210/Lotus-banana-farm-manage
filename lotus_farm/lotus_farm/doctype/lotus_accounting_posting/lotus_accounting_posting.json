{
  "doctype": "DocType",
  "name": "Lotus Accounting Posting",
  "module": "Lotus Farm",
  "track_changes": 1,
  "description": "Liên kết một chứng từ Lotus với chứng từ kế toán ERPNext đã ghi sổ. Mỗi chứng từ nguồn chỉ có một lần ghi đang hiệu lực cho mỗi mục đích.",
  "fields": [
    {
      "fieldname": "company",
      "label": "Công ty",
      "fieldtype": "Link",
      "options": "Company"
    },
    {
      "fieldname": "source_doctype",
      "label": "Loại chứng từ nguồn",
      "fieldtype": "Link",
      "options": "DocType",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "source_name",
      "label": "Số chứng từ nguồn",
      "fieldtype": "Dynamic Link",
      "options": "source_doctype",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "purpose",
      "label": "Mục đích",
      "fieldtype": "Select",
      "options": "Purchase Invoice\nSupplier Payment\nPayroll\nSalary Payment\nOpening Balance\nChart Transfer\nCost Closing\nAdjustment\nHarvest Receipt\nCosting",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "source_hash",
      "label": "Dấu nội dung nguồn lúc ghi",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "voucher_type",
      "label": "Loại chứng từ kế toán",
      "fieldtype": "Link",
      "options": "DocType",
      "read_only": 1
    },
    {
      "fieldname": "voucher_name",
      "label": "Số chứng từ kế toán",
      "fieldtype": "Dynamic Link",
      "options": "voucher_type",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "posting_date",
      "label": "Ngày hạch toán",
      "fieldtype": "Date",
      "read_only": 1
    },
    {
      "fieldname": "amount",
      "label": "Số tiền",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "state",
      "label": "Trạng thái",
      "fieldtype": "Select",
      "options": "Draft\nPosted\nReversed",
      "default": "Draft",
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "active_key",
      "label": "Khóa chống ghi trùng",
      "fieldtype": "Data",
      "unique": 1,
      "read_only": 1,
      "hidden": 1

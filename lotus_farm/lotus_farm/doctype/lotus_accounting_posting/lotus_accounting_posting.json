      "role": "Lotus Chief Accountant",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Lotus Accountant",
      "read": 1,
      "report": 1,
      "export": 1
    },
    {
      "role": "Lotus Auditor",
      "read": 1,
      "report": 1
    }

    {
      "fieldname": "posted_by",
      "label": "Người ghi sổ",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "posted_at",
      "label": "Ghi sổ lúc",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "reversed_by",
      "label": "Người đảo",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "reversed_at",
      "label": "Đảo lúc",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "reason",
      "label": "Lý do đảo",
      "fieldtype": "Small Text",
      "read_only": 1
    }

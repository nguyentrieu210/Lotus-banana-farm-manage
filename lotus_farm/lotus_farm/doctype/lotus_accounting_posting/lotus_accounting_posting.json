  "field_order": [
    "company",
    "source_doctype",
    "source_name",
    "purpose",
    "source_hash",
    "voucher_type",
    "voucher_name",
    "posting_date",
    "amount",
    "state",
    "active_key",
    "posted_by",
    "posted_at",
    "reversed_by",
    "reversed_at",
    "reason"

# HR-only changes: retain all installed Lotus apps and hashed assets.
FROM lotus-hr-mobile:v1-20261019
USER root
COPY --chown=frappe:root lotus_farm/hr_setup.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/hr_setup.py
COPY --chown=frappe:root lotus_farm/push_notifications.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/push_notifications.py
COPY --chown=frappe:root lotus_farm/hooks.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/hooks.py
COPY --chown=frappe:root lotus_farm/public/js/role_list.js /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/js/role_list.js
COPY --chown=frappe:root lotus_farm/lotus_farm/doctype/lotus_push_device/lotus_push_device.json /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/lotus_farm/doctype/lotus_push_device/lotus_push_device.json
COPY --chown=frappe:root lotus_farm/lotus_farm/doctype/lotus_mobile_alert/lotus_mobile_alert.json /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/lotus_farm/doctype/lotus_mobile_alert/lotus_mobile_alert.json
COPY --chown=frappe:root lotus_farm/public/hr-mobile-worker.js /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/hr-mobile-worker.js
COPY --chown=frappe:root lotus_farm/public/frontend/ /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend/
USER frappe

# Scoped HR mobile PWA release on top of existing QR + plan norm + HR changes.
FROM lotus-cccd-qr:v1-20261018
USER root
COPY --chown=frappe:root lotus_farm/hr_workspace.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/hr_workspace.py
COPY --chown=frappe:root lotus_farm/web.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/web.py
COPY --chown=frappe:root lotus_farm/hooks.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/hooks.py
COPY --chown=frappe:root lotus_farm/www/hr_mobile.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/www/hr_mobile.py
COPY --chown=frappe:root lotus_farm/www/hr_mobile.html /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/www/hr_mobile.html
COPY --chown=frappe:root lotus_farm/public/hr-mobile.webmanifest /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/hr-mobile.webmanifest
COPY --chown=frappe:root lotus_farm/public/hr-mobile-worker.js /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/hr-mobile-worker.js
COPY --chown=frappe:root lotus_farm/public/hr-mobile-offline.html /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/hr-mobile-offline.html
COPY --chown=frappe:root lotus_farm/public/images/hr-icon-192.png /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/images/hr-icon-192.png
COPY --chown=frappe:root lotus_farm/public/images/hr-icon-512.png /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/images/hr-icon-512.png
COPY --chown=frappe:root lotus_farm/public/images/hr-icon-maskable-512.png /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/images/hr-icon-maskable-512.png
# Overlay new hashed static files, keeping all older assets needed by existing apps.
COPY --chown=frappe:root lotus_farm/public/frontend/assets/ /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend/assets/
COPY --chown=frappe:root lotus_farm/public/frontend/.vite/manifest.json /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend/.vite/manifest.json
COPY --chown=frappe:root lotus_farm/public/frontend/hr.html /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend/hr.html
COPY --chown=frappe:root lotus_farm/public/frontend/hr-mobile.html /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend/hr-mobile.html
USER frappe

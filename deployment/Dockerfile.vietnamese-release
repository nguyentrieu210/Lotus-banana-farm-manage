# Build context: exact git archives plus the tested Lotus frontend bundle.
ARG BASE_IMAGE=lotus-vi-base:verified
FROM ${BASE_IMAGE}
ARG REVISION
ARG DML_REVISION
ARG BASE_IMAGE_ID
USER root
COPY --chown=frappe:root app/frontend/ /home/frappe/frappe-bench/apps/lotus_farm/frontend/
COPY --chown=frappe:root app/lotus_farm/public/frontend/ /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend/
COPY --chown=frappe:root app/lotus_farm/translations/vi.csv /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/translations/vi.csv
COPY --chown=frappe:root app/lotus_farm/vietnamese.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/vietnamese.py
COPY --chown=frappe:root app/deployment/translations/frappe-vi.po /home/frappe/frappe-bench/apps/frappe/frappe/locale/vi.po
COPY --chown=frappe:root app/deployment/translations/erpnext-vi.po /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/vi.po
COPY --chown=frappe:root app/deployment/translations/hrms-vi.po /home/frappe/frappe-bench/apps/hrms/hrms/locale/vi.po
COPY --chown=frappe:root app/deployment/compile_vietnamese.py /tmp/compile_vietnamese.py
RUN chmod 644 /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/vietnamese.py /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/translations/vi.csv /home/frappe/frappe-bench/apps/frappe/frappe/locale/vi.po /home/frappe/frappe-bench/apps/erpnext/erpnext/locale/vi.po /home/frappe/frappe-bench/apps/hrms/hrms/locale/vi.po \
 && find /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend -type d -exec chmod 755 {} + \
 && find /home/frappe/frappe-bench/apps/lotus_farm/lotus_farm/public/frontend -type f -exec chmod 644 {} +
LABEL org.opencontainers.image.revision=${REVISION} \
      com.lotus.dml.revision=${DML_REVISION} \
      com.lotus.base.image.id=${BASE_IMAGE_ID} \
      org.opencontainers.image.source=https://github.com/nguyentrieu210/Lotus-banana-farm-manage
USER frappe
RUN /home/frappe/frappe-bench/env/bin/python /tmp/compile_vietnamese.py
